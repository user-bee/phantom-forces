-- config tab
local configMain = tabs.config:addLeftGroupbox('aimbot')

-- functions
local function GetBoundingBox2D(cframe, size)
    local x, y, z = size.X / 2, size.Y / 2, size.Z / 2
    
    local corners = {
        cframe * CFrame.new(x, y, z),
        cframe * CFrame.new(-x, y, z),
        cframe * CFrame.new(x, -y, z),
        cframe * CFrame.new(-x, -y, z),
        cframe * CFrame.new(x, y, -z),
        cframe * CFrame.new(-x, y, -z),
        cframe * CFrame.new(x, -y, -z),
        cframe * CFrame.new(-x, -y, -z)
    }
    
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local isVisible = false

    for _, corner in ipairs(corners) do
        local screenPos, onScreen = camera:WorldToViewportPoint(corner.Position)
        if onScreen then
            isVisible = true
        end
        if screenPos.X < minX then minX = screenPos.X end
        if screenPos.X > maxX then maxX = screenPos.X end
        if screenPos.Y < minY then minY = screenPos.Y end
        if screenPos.Y > maxY then maxY = screenPos.Y end
    end

    return isVisible, Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

-- connections
rs.RenderStepped:Connect(function()
    for _, char in ipairs(charFolder:GetDescendants()) do
        if char:IsA("Model") then
            if not loggedChars[char] then
                local box = Drawing.new("Square")
                box.Color = Color3.fromRGB(255, 255, 255)
                box.Thickness = 1
                box.Filled = false
                box.Transparency = 1
                box.Visible = false
                
                loggedChars[char] = box
            end
        end
    end

    for char, box in pairs(loggedChars) do
        if char and char.Parent then
            local cf, size = char:GetBoundingBox()
            if size.Magnitude > 0 then
                local isVisible, pos, boxSize = GetBoundingBox2D(cf, size)
                if isVisible then
                    if toggles.boxEsp.value then
                        box.Size = boxSize
                        box.Position = pos
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        else
            box:Remove()
            loggedChars[char] = nil
        end
    end
end)

ui:notify("loaded", 3)
ui:notify("use RSHIFT to toggle menu", 3)
