local camera = workspace.CurrentCamera
local mouse = player:GetMouse()

local ui = loadstring(game:HttpGet('https://raw.githubusercontent.com/user-bee/modules/refs/heads/main/ui.luau'))()
local drawing = loadstring(game:HttpGet('https://raw.githubusercontent.com/user-bee/modules/refs/heads/main/drawing.lua'))()

local charFolder = game:GetService("Workspace"):WaitForChild("Players")
local loggedChars = {}

ui.useCustomCursor = false
ui.fontColor = Color3.fromRGB(245, 245, 250)
ui.mainColor = Color3.fromRGB(25, 25, 30)
ui.backgroundColor = Color3.fromRGB(15, 15, 20) 
ui.accentColor = Color3.fromRGB(140, 90, 255) 
ui.outlineColor = Color3.fromRGB(45, 45, 50)
ui.riskColor = Color3.fromRGB(255, 75, 75)
ui.accentColorDark = Color3.fromRGB(45, 45, 50)

-- main window
local window = ui:createWindow({Title = 'nowlol', Center = true, AutoShow = true, TabPadding = 8, MenuFadeTime = 0.2, Size = UDim2.fromOffset(400, 600)})
local tabs = {visual = window:addTab('visual'), combat = window:addTab('combat'), config = window:addTab("config")}

-- visual tab
